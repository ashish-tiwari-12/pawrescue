# PawConnect NGO Client - Environment Configuration Example
# Copy this file to .env and configure for your deployment

# The base URL for the backend API
# For local development: http://localhost:5000/api
# For production: https://your-backend-api-url.com/api
VITE_API_URL=http://localhost:5000/api

# The URL for the Socket.IO real-time connection
# For local development: http://localhost:5000
# For production: https://your-backend-api-url.com
VITE_SOCKET_URL=http://localhost:5000
