# PawConnect Server Environment Variables

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/pawrescue?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Nodemailer Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cloudinary Cloud Storage Configuration (for Photos & Media)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Alternate Cloudinary naming support
CLODINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLODINARY_API_KEY=your_cloudinary_api_key
CLODINARY_API_SECRET_KEY=your_cloudinary_api_secret_key

# ==============================================================================
# AI Vision & Feature Matching Engine (OPTIONAL)
# NOTE: The system includes a built-in AI profiling & matching engine in Node.js.
# You DO NOT need to deploy the Python 'ai-service' or add Gemini/OpenAI keys unless
# you specifically want to route requests through an external microservice or LLM.
# ==============================================================================
# AI_SERVICE_URL=http://localhost:8000   # Optional: Python FastAPI microservice
# GEMINI_API_KEY=                       # Optional: Google Gemini Vision API
# OPENAI_API_KEY=                       # Optional: OpenAI GPT-4o Vision API
